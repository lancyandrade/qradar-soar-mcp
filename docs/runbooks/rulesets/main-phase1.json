{
  "name": "main: pull request + CI",
  "target": "branch",
  "enforcement": "active",
  "conditions": {
    "ref_name": {
      "include": ["~DEFAULT_BRANCH"],
      "exclude": []
    }
  },
  "bypass_actors": [],
  "rules": [
    { "type": "deletion" },
    { "type": "non_fast_forward" },
    {
      "type": "pull_request",
      "parameters": {
        "required_approving_review_count": 0,
        "dismiss_stale_reviews_on_push": true,
        "require_code_owner_review": false,
        "require_last_push_approval": false,
        "required_review_thread_resolution": true,
        "allowed_merge_methods": ["merge"]
      }
    },
    {
      "type": "required_status_checks",
      "parameters": {
        "strict_required_status_checks_policy": true,
        "do_not_enforce_on_create": false,
        "required_status_checks": [
          { "context": "secret scan (gitleaks, full history)", "integration_id": 15368 },
          { "context": "test (ubuntu-latest, 3.12)", "integration_id": 15368 },
          { "context": "test (ubuntu-latest, 3.13)", "integration_id": 15368 },
          { "context": "test (windows-latest, 3.12)", "integration_id": 15368 },
          { "context": "test (windows-latest, 3.13)", "integration_id": 15368 },
          { "context": "dependency audit (pip-audit)", "integration_id": 15368 }
        ]
      }
    }
  ]
}
