# Normalize repository text files to LF
* text=auto

*.py   text eol=lf
*.md   text eol=lf
*.toml text eol=lf
*.yaml text eol=lf
*.yml  text eol=lf
*.json text eol=lf
*.sh   text eol=lf
*.env  text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf
.python-version text eol=lf

# Windows-native scripts
*.ps1 text eol=crlf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
