# qradar-soar-mcp — copy to .env and fill in.
# .env must never be committed. Verify: git check-ignore -v .env
#
# EVERY capability below defaults to false. Absent, empty or unparseable
# values resolve to false. Nothing here fails open.
#
# The server reads its process environment only; it never opens this file.
# Load it into the environment yourself (for example `set -a; . ./.env; set +a`)
# or copy the values into your MCP client's `env` block. Comments stay on lines
# of their own, so that loaders which do not strip a trailing `# ...` (Docker
# --env-file, systemd EnvironmentFile) cannot turn one into part of a value.

# ── connection ───────────────────────────────────────────────────────────────
SOAR_BASE_URL=https://soar.example.internal
SOAR_ORG_ID=201

# Administrator Settings -> API Keys. Start with a read-only permission set.
SOAR_API_KEY_ID=
SOAR_API_KEY_SECRET=

# TLS verification. Leave this true. With no SOAR_CA_BUNDLE the server uses
# Python's default TLS trust configuration: whatever ssl.create_default_context()
# exposes on this platform and Python build (often, not always, the OS store).
SOAR_VERIFY_SSL=true
# Private or self-signed CA? Keep SOAR_VERIFY_SSL=true and name the CA's PEM
# certificate here. The supplied bundle is then used instead of Python's default
# trust; the host name in SOAR_BASE_URL must still match the certificate.
# Empty = Python's default trust.
SOAR_CA_BUNDLE=
# SOAR_VERIFY_SSL=false exposes the API key to interception. It is refused
# unless SOAR_LAB_MODE=true is also set, and is for throwaway labs only.
SOAR_TIMEOUT=30
SOAR_MAX_RESULTS=50

# ── Tier 1 — documentation ───────────────────────────────────────────────────
SOAR_ALLOW_COMMENTS=false
SOAR_ALLOW_ARTIFACTS=false

# ── Tier 2 — SOAR modification ───────────────────────────────────────────────
SOAR_ALLOW_INCIDENT_WRITES=false
SOAR_ALLOW_TASK_WRITES=false
SOAR_ALLOW_INCIDENT_CLOSE=false

# ── Tier 3 — security control actions ────────────────────────────────────────
# These reach through SOAR to the AppHost and on to your EDR / firewall / IAM.
# SOAR_ALLOW_ACTIONS=true REQUIRES a policy file; the server will not start
# without one. Any action not classified in that file is denied.
SOAR_ALLOW_ACTIONS=false
SOAR_ALLOW_DESTRUCTIVE_ACTIONS=false
SOAR_ACTION_POLICY_FILE=./config/action_policy.yaml

# ── Tier 4 — automation modification (reserved) ──────────────────────────────
# Accepted and reported by --check; no tool in this release uses them.
# DRAFT: local IR authoring only; writes nothing. It is the one flag this file
# sets to true (the design baseline's choice; the code default is false), so
# --check lists it even though nothing reads it. EXPORT: compile IR to a bundle
# on disk. CREATE: import into SOAR (always disabled state). MODIFY: import over
# an existing playbook. ENABLE: activate a playbook, separate on purpose.
# SOAR_ALLOW_PLAYBOOK_DEPLOY also exists and defaults to false.
SOAR_ALLOW_PLAYBOOK_DRAFT=true
SOAR_ALLOW_PLAYBOOK_EXPORT=false
SOAR_ALLOW_PLAYBOOK_CREATE=false
SOAR_ALLOW_PLAYBOOK_MODIFY=false
SOAR_ALLOW_PLAYBOOK_ENABLE=false
SOAR_PLAYBOOK_EXPORT_DIR=./out/playbooks

# Reserved. Arbitrary script authoring is an architectural non-goal.
# Leave false. There is no supported configuration in which this is true.
SOAR_ALLOW_SCRIPT_WRITES=false

# ── approval ─────────────────────────────────────────────────────────────────
# out_of_band | in_band | disabled
#
# in_band means the model echoes back a token it can read from its own context.
# That prevents accidents. It is NOT human approval. out_of_band is required
# for Tier 3+ unless SOAR_LAB_MODE=true. (No tool in this release asks for an
# approval: soar_invoke_action refuses every call before that step.)
SOAR_APPROVAL_MODE=out_of_band
# Leave both true. false removes the approval requirement for a Tier-3 action
# whose policy rule says "allow", and is not restricted to lab mode.
SOAR_REQUIRE_ACTION_CONFIRMATION=true
SOAR_REQUIRE_PLAYBOOK_CONFIRMATION=true
SOAR_APPROVAL_BROKER_PATH=/var/lib/qradar-soar-mcp/approvals
# Ed25519 (08 §5): the server holds only the PUBLIC key. The private key is used
# by the separate `qradar-soar-approve` environment (SOAR_APPROVAL_PRIVATE_KEY_FILE)
# and must never be readable by the MCP server.
SOAR_APPROVAL_PUBLIC_KEY_FILE=/etc/qradar-soar-mcp/approval.pub
SOAR_APPROVAL_TTL_SECONDS=900

# ── blast-radius caps ────────────────────────────────────────────────────────
SOAR_MAX_MUTATIONS_PER_CALL=1
SOAR_MAX_TIER2_PER_HOUR=25
SOAR_MAX_TIER3_PER_HOUR=5
# Tier 1 (notes, artifacts) has no hourly cap.
# Reserved for Phase 3:
SOAR_SIM_MAX_INCIDENTS=25

# ── audit & safety ───────────────────────────────────────────────────────────
# One audit log per server process: two processes must never share one.
SOAR_AUDIT_LOG_PATH=/var/log/qradar-soar-mcp/audit.jsonl
# Unwritable audit log => refuse to start.
SOAR_AUDIT_REQUIRED=true
# Reserved for Phase 4.
SOAR_SNAPSHOT_DIR=/var/lib/qradar-soar-mcp/snapshots
# While this file exists every Tier >= 1 call is denied; reads continue.
SOAR_KILL_SWITCH_FILE=/etc/qradar-soar-mcp/HALT
SOAR_LOG_LEVEL=INFO

# ── catalog ──────────────────────────────────────────────────────────────────
# collections = the read-only collection endpoints (verified with a read-only key).
# export is selectable but unavailable: the configuration export is unverified (the one
# attempt was answered HTTP 403), so every catalog load fails and nothing falls back.
# collections | export (unavailable)
SOAR_CATALOG_SOURCE=collections
# 0 = reload on every read; soar_refresh_catalog ignores it.
SOAR_CATALOG_TTL_SECONDS=300

# ── transport ────────────────────────────────────────────────────────────────
# stdio is the supported path. streamable-http is secondary: it requires a
# bearer token, must sit behind a TLS-terminating reverse proxy, and Tier 3+
# capabilities are hard-disabled over it regardless of the flags above.
SOAR_MCP_TRANSPORT=stdio
SOAR_MCP_HOST=127.0.0.1
SOAR_MCP_PORT=8090
SOAR_HTTP_AUTH_TOKEN=
SOAR_HTTP_ACKNOWLEDGE_EXPOSURE=false

# ── lab only ─────────────────────────────────────────────────────────────────
# Acknowledges a throwaway lab. On its own it changes nothing; it is what lets
# SOAR_APPROVAL_MODE=in_band|disabled and SOAR_VERIFY_SSL=false be accepted.
# Never set this in production.
SOAR_LAB_MODE=false

# ── DEPRECATED ───────────────────────────────────────────────────────────────
# SOAR_ALLOW_WRITES is honoured for one minor version. It maps to the Tier 1-2
# flags only and deliberately does NOT enable SOAR_ALLOW_ACTIONS — nobody who
# set it intended to authorise endpoint isolation.
# SOAR_ALLOW_WRITES=false
